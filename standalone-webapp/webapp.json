{
  "schemaVersion": 2,
  "id": "webapp-a0d1700000000001",
  "key": "standalone-auditor",
  "label": "独立审阅助手",
  "version": "1.0.0",
  "target": "any",
  "hosting": "platform",
  "minPlatformVersion": "0.5.47",
  "appConfig": {
    "modelMode": "demo",
    "agentKey": "auditor",
    "skillId": "review-checklist",
    "model": "auditor-model",
    "reportStorage": "server",
    "deployment": "nginx-backend"
  },
  "frontend": {
    "root": "frontend",
    "index": "index.html",
    "routeConfig": {
      "backendPrefixes": [
        "/api"
      ]
    }
  },
  "copilot": {
    "agentKey": "auditor",
    "references": [
      {
        "type": "skill",
        "id": "review-checklist"
      }
    ]
  },
  "authentication": {
    "mode": "none"
  },
  "backend": {
    "command": {
      "type": "node",
      "entry": "backend/server.mjs"
    },
    "args": [],
    "env": {},
    "health": {
      "type": "http",
      "path": "/api/health",
      "startupTimeoutMs": 30000
    },
    "shutdownTimeoutMs": 3000
  }
}
