{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://zenmind.local/platform-auditor/schemas/common/common.schema.json",
  "definitions": {
    "role": {
      "type": "string",
      "enum": [
        "user",
        "assistant",
        "system",
        "tool"
      ]
    },
    "queryRole": {
      "type": "string",
      "enum": [
        "user",
        "assistant",
        "automation",
        "system"
      ]
    },
    "positiveInteger": {
      "type": "integer",
      "minimum": 1
    },
    "nonNegativeInteger": {
      "type": "integer",
      "minimum": 0
    },
    "nonNegativeNumber": {
      "type": "number",
      "minimum": 0
    },
    "accessLevel": {
      "type": "string",
      "enum": [
        "default",
        "auto_approve",
        "full_access"
      ]
    },
    "taskStatus": {
      "type": "string",
      "enum": [
        "running",
        "completed",
        "failed",
        "cancelled",
        "pending"
      ]
    },
    "planExecuteStage": {
      "type": "string",
      "enum": [
        "plan",
        "execute",
        "summary"
      ]
    },
    "streamEventType": {
      "type": "string",
      "enum": [
        "request.query",
        "awaiting.ask",
        "awaiting.answer",
        "request.submit",
        "request.steer",
        "chat.start",
        "run.start",
        "debug.preCall",
        "debug.postCall",
        "usage.snapshot",
        "memory.write",
        "memory.read",
        "memory.search",
        "memory.update",
        "memory.forget",
        "memory.timeline",
        "memory.promote",
        "memory.consolidate",
        "run.complete",
        "run.cancel",
        "run.error",
        "reasoning.start",
        "reasoning.delta",
        "reasoning.end",
        "reasoning.snapshot",
        "content.start",
        "content.delta",
        "content.end",
        "content.snapshot",
        "tool.start",
        "tool.args",
        "tool.end",
        "tool.snapshot",
        "tool.result",
        "source.publish",
        "action.start",
        "action.args",
        "action.end",
        "action.snapshot",
        "action.result",
        "plan.create",
        "plan.update",
        "planning.delta",
        "planning.snapshot",
        "task.start",
        "task.complete",
        "task.cancel",
        "task.error",
        "artifact.publish"
      ]
    },
    "queryPayload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requestId": {
          "type": ["string", "null"]
        },
        "chatId": {
          "type": ["string", "null"]
        },
        "role": {
          "type": ["string", "null"]
        },
        "message": {
          "type": ["string", "null"]
        },
        "runId": {
          "type": ["string", "null"]
        },
        "agentKey": {
          "type": ["string", "null"]
        },
        "teamId": {},
        "mustUseSkills": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "model": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "key": {
              "type": ["string", "null"]
            },
            "modelId": {
              "type": ["string", "null"]
            },
            "reasoningEffort": {
              "type": ["string", "null"]
            },
            "serviceTier": {
              "type": ["string", "null"]
            }
          }
        },
        "accessLevel": {
          "type": ["string", "null"]
        },
        "liveSeq": {
          "$ref": "#/definitions/positiveInteger"
        },
        "references": {
          "type": ["array", "null"],
          "items": {
            "$ref": "#/definitions/rawInputReference"
          }
        },
        "params": {},
        "scene": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "url": {
              "type": ["string", "null"]
            },
            "title": {
              "type": ["string", "null"]
            }
          }
        },
        "stream": {
          "type": ["boolean", "null"]
        },
        "planningMode": {
          "type": ["boolean", "null"]
        },
        "lane": {
          "type": ["string", "null"]
        },
        "sideId": {
          "type": ["string", "null"]
        },
        "sourceUser": {
          "type": ["string", "null"]
        },
        "chatName": {
          "type": ["string", "null"]
        },
        "modelKey": {
          "type": ["string", "null"]
        },
        "reasoningEffort": {
          "type": ["string", "null"]
        },
        "subAgentKey": {
          "type": ["string", "null"]
        },
        "taskAgentKey": {
          "type": ["string", "null"]
        },
        "task": {
          "type": ["string", "null"]
        },
        "taskName": {
          "type": ["string", "null"]
        },
        "kind": {
          "type": ["string", "null"]
        },
        "detached": {
          "type": ["boolean", "null"]
        },
        "hidden": {
          "type": ["boolean", "null"]
        },
        "editingMode": {
          "type": ["boolean", "null"]
        },
        "includeUsage": {
          "type": ["boolean", "null"]
        },
        "includeFullText": {
          "type": ["boolean", "null"]
        },
        "files": {
          "type": ["array", "null"],
          "items": {
            "type": "string"
          }
        },
        "runOrigin": {
          "type": "object",
          "additionalProperties": true
        },
        "source": {
          "type": "string"
        }
      },
      "$comment": "Caller input is stored before IDs, defaults and model/reference resolution. All fields are optional; historical resolved query payloads remain readable."
    },
    "contextWindow": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxSize": {
          "type": "number"
        },
        "currentSize": {
          "type": "number"
        },
        "estimatedNextCallSize": {
          "type": "number"
        }
      }
    },
    "estimatedCost": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "currency": {
          "type": "string"
        },
        "inputCacheHit": {
          "$ref": "#/definitions/nonNegativeNumber"
        },
        "inputCacheMiss": {
          "$ref": "#/definitions/nonNegativeNumber"
        },
        "output": {
          "$ref": "#/definitions/nonNegativeNumber"
        },
        "total": {
          "$ref": "#/definitions/nonNegativeNumber"
        }
      }
    },
    "usageTiming": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "firstTokenLatencyMs": {
          "$ref": "#/definitions/nonNegativeInteger"
        },
        "generationDurationMs": {
          "$ref": "#/definitions/nonNegativeInteger"
        }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "promptTokens": {
          "type": "number",
          "minimum": 0
        },
        "completionTokens": {
          "type": "number",
          "minimum": 0
        },
        "totalTokens": {
          "type": "number",
          "minimum": 0
        },
        "llmChatCompletionCount": {
          "type": "number",
          "minimum": 0
        },
        "toolCallCount": {
          "type": "number",
          "minimum": 0
        },
        "promptTokensDetails": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cacheHitTokens": {
              "$ref": "#/definitions/nonNegativeNumber"
            },
            "cacheMissTokens": {
              "$ref": "#/definitions/nonNegativeNumber"
            }
          }
        },
        "completionTokensDetails": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "reasoningTokens": {
              "$ref": "#/definitions/nonNegativeNumber"
            }
          }
        },
        "estimatedCost": {
          "$ref": "#/definitions/estimatedCost"
        },
        "timing": {
          "$ref": "#/definitions/usageTiming"
        }
      }
    },
    "reactUsage": {
      "type": "object",
      "required": [
        "promptTokens",
        "completionTokens",
        "totalTokens"
      ],
      "additionalProperties": false,
      "properties": {
        "promptTokens": {
          "$ref": "#/definitions/nonNegativeInteger"
        },
        "completionTokens": {
          "$ref": "#/definitions/nonNegativeInteger"
        },
        "totalTokens": {
          "$ref": "#/definitions/nonNegativeInteger"
        },
        "llmChatCompletionCount": {
          "$ref": "#/definitions/nonNegativeInteger"
        },
        "toolCallCount": {
          "$ref": "#/definitions/nonNegativeInteger"
        },
        "promptTokensDetails": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cacheHitTokens": {
              "$ref": "#/definitions/nonNegativeInteger"
            },
            "cacheMissTokens": {
              "$ref": "#/definitions/nonNegativeInteger"
            }
          }
        },
        "completionTokensDetails": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "reasoningTokens": {
              "$ref": "#/definitions/nonNegativeInteger"
            }
          }
        },
        "estimatedCost": {
          "$ref": "#/definitions/estimatedCost"
        },
        "timing": {
          "$ref": "#/definitions/usageTiming"
        }
      }
    },
    "reactContextWindow": {
      "type": "object",
      "required": [
        "currentSize",
        "maxSize"
      ],
      "additionalProperties": false,
      "properties": {
        "maxSize": {
          "type": "integer",
          "minimum": 1
        },
        "currentSize": {
          "$ref": "#/definitions/nonNegativeInteger"
        },
        "estimatedNextCallSize": {
          "$ref": "#/definitions/nonNegativeInteger"
        }
      }
    },
    "toolCallFunction": {
      "type": "object",
      "required": [
        "name",
        "arguments"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "arguments": {
          "type": "string"
        }
      }
    },
    "toolCall": {
      "type": "object",
      "required": [
        "id",
        "type",
        "function"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "function"
          ]
        },
        "function": {
          "$ref": "#/definitions/toolCallFunction"
        },
        "_toolId": {
          "type": "string"
        }
      }
    },
    "llmChatRole": {
      "type": "string",
      "enum": [
        "system",
        "developer",
        "user",
        "assistant",
        "tool"
      ]
    },
    "llmChatMessageContent": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "array"
        },
        {
          "type": "null"
        }
      ]
    },
    "llmChatMessage": {
      "type": "object",
      "required": [
        "role",
        "content"
      ],
      "additionalProperties": true,
      "properties": {
        "role": {
          "$ref": "#/definitions/llmChatRole"
        },
        "content": {
          "$ref": "#/definitions/llmChatMessageContent"
        },
        "name": {
          "type": "string"
        },
        "tool_call_id": {
          "type": "string"
        },
        "tool_calls": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/toolCall"
          }
        }
      }
    },
    "llmChatMessages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/llmChatMessage"
      }
    },
    "llmToolChoice": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "auto",
            "none",
            "required"
          ]
        },
        {
          "type": "object",
          "additionalProperties": true
        }
      ]
    },
    "llmStreamOptions": {
      "type": "object",
      "required": [
        "include_usage"
      ],
      "additionalProperties": true,
      "properties": {
        "include_usage": {
          "type": "boolean"
        }
      }
    },
    "llmRequestOptions": {
      "type": "object",
      "$comment": "Request options snapshot actual provider parameters; temperature and stream_options are protocol/configuration dependent.",
      "required": [
        "stream"
      ],
      "additionalProperties": true,
      "properties": {
        "stream": {
          "type": "boolean"
        },
        "stream_options": {
          "$ref": "#/definitions/llmStreamOptions"
        },
        "temperature": {
          "type": "number"
        }
      }
    },
    "message": {
      "type": "object",
      "required": [
        "role"
      ],
      "additionalProperties": false,
      "properties": {
        "role": {
          "$ref": "#/definitions/role"
        },
        "content": {
          "type": "array"
        },
        "ts": {
          "type": "number"
        },
        "durationMs": {
          "$ref": "#/definitions/nonNegativeNumber"
        },
        "tool_calls": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/toolCall"
          }
        },
        "name": {
          "type": "string"
        },
        "tool_call_id": {
          "type": "string"
        },
        "reasoning_content": {
          "type": "array"
        },
        "approval": {
          "type": "object",
          "additionalProperties": true
        },
        "_reasoningId": {
          "type": "string"
        },
        "_contentId": {
          "type": "string"
        },
        "_msgId": {
          "type": "string"
        },
        "_toolId": {
          "type": "string"
        },
        "_actionId": {
          "type": "string"
        },
        "_liveSeq": {
          "$ref": "#/definitions/positiveInteger"
        }
      }
    },
    "awaitingItem": {
      "type": "object",
      "required": [
        "awaitingId",
        "mode",
        "type",
        "runId",
        "agentKey",
        "timestamp",
        "view"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": [
              "mode"
            ],
            "properties": {
              "mode": {
                "const": "approval"
              }
            }
          },
          "then": {
            "required": [
              "approvals",
              "timeout"
            ]
          }
        },
        {
          "if": {
            "required": [
              "mode"
            ],
            "properties": {
              "mode": {
                "const": "question"
              }
            }
          },
          "then": {
            "required": [
              "questions",
              "timeout"
            ]
          }
        },
        {
          "if": {
            "required": [
              "mode"
            ],
            "properties": {
              "mode": {
                "const": "form"
              }
            }
          },
          "then": {
            "required": [
              "form",
              "timeout"
            ]
          }
        },
        {
          "if": {
            "required": [
              "mode"
            ],
            "properties": {
              "mode": {
                "const": "planning"
              }
            }
          },
          "then": {
            "required": [
              "planning"
            ]
          }
        }
      ],
      "properties": {
        "awaitingId": {
          "type": "string"
        },
        "mode": {
          "type": "string",
          "enum": [
            "approval",
            "question",
            "form",
            "planning"
          ]
        },
        "type": {
          "type": "string",
          "enum": [
            "awaiting.ask"
          ]
        },
        "runId": {
          "type": "string"
        },
        "agentKey": {
          "type": "string"
        },
        "timestamp": {
          "type": "number"
        },
        "timeout": {
          "type": "number"
        },
        "questions": {
          "$ref": "#/definitions/awaitingObjectArray"
        },
        "approvals": {
          "$ref": "#/definitions/awaitingObjectArray"
        },
        "form": {
          "type": "object"
        },
        "planning": {
          "$ref": "#/definitions/awaitingPlanning"
        },
        "view": {
          "type": "object",
          "required": [
            "source",
            "key"
          ],
          "properties": {
            "source": {
              "enum": [
                "builtin",
                "connector"
              ]
            },
            "key": {
              "type": "string"
            },
            "renderer": {
              "enum": [
                "native",
                "html",
                "qlc"
              ]
            },
            "connectorId": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "hash": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      }
    },
    "awaitingObjectArray": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "awaitingPlanning": {
      "type": "object",
      "required": [
        "id",
        "options"
      ],
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "planningFile": {
          "type": "string"
        },
        "planningId": {
          "type": "string"
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/awaitingPlanningOption"
          }
        }
      }
    },
    "awaitingPlanningOption": {
      "type": "object",
      "required": [
        "decision"
      ],
      "additionalProperties": true,
      "properties": {
        "decision": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "input": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "planningEvent": {
      "type": "object",
      "required": [
        "type",
        "planningId",
        "chatId",
        "runId",
        "timestamp"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "$ref": "#/definitions/streamEventType"
        },
        "planningId": {
          "type": "string"
        },
        "chatId": {
          "type": "string"
        },
        "runId": {
          "type": "string"
        },
        "timestamp": {
          "type": "number"
        },
        "planningFile": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      }
    },
    "eventPayload": {
      "type": "object",
      "required": [
        "type",
        "timestamp"
      ],
      "additionalProperties": true,
      "properties": {
        "type": {
          "$ref": "#/definitions/streamEventType"
        },
        "timestamp": {
          "type": "number"
        },
        "seq": {
          "$ref": "#/definitions/positiveInteger"
        },
        "chatId": {
          "type": "string"
        },
        "runId": {
          "type": "string"
        },
        "requestId": {
          "type": "string"
        },
        "agentKey": {
          "type": "string"
        },
        "taskId": {
          "type": "string"
        }
      }
    },
    "steerPayload": {
      "type": "object",
      "required": [
        "chatId",
        "runId",
        "steerId",
        "message",
        "role"
      ],
      "additionalProperties": false,
      "properties": {
        "requestId": {
          "type": "string",
          "minLength": 1
        },
        "chatId": {
          "type": "string",
          "minLength": 1
        },
        "runId": {
          "type": "string",
          "minLength": 1
        },
        "steerId": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string"
        },
        "role": {
          "type": "string",
          "const": "user"
        },
        "origin": {
          "$ref": "#/definitions/agentOrigin"
        },
        "source": {
          "$ref": "#/definitions/agentOrigin",
          "$comment": "Historical name, accepted by the platform for existing steer lines."
        },
        "references": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "systemMessage": {
      "type": "object",
      "required": [
        "role",
        "content"
      ],
      "additionalProperties": false,
      "properties": {
        "role": {
          "$ref": "#/definitions/role"
        },
        "content": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array"
            }
          ]
        },
        "name": {
          "type": "string"
        }
      }
    },
    "stringMap": {
      "type": "object",
      "additionalProperties": true
    },
    "messageArray": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/message"
      }
    },
    "awaitingArray": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/awaitingItem"
      }
    },
    "queryOrigin": {
      "type": "object",
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "user",
            "agent",
            "automation"
          ]
        },
        "userId": {
          "type": "string",
          "minLength": 1
        },
        "agentKey": {
          "type": "string",
          "minLength": 1
        },
        "chatId": {
          "type": "string",
          "minLength": 1
        },
        "runId": {
          "type": "string",
          "minLength": 1
        },
        "toolId": {
          "type": "string",
          "minLength": 1
        },
        "automationId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "agentOrigin": {
      "type": "object",
      "required": [
        "type",
        "agentKey",
        "chatId",
        "runId",
        "toolId"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "agent"
        },
        "agentKey": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "chatId": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "runId": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "toolId": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "inputReference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "annotation": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "mimeType": {
          "type": "string"
        },
        "url": {
