{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://zenmind.local/platform-auditor/schemas/jsonl/react.schema.json",
  "type": "object",
  "required": ["chatId", "runId", "updatedAt", "messages", "_type", "usage", "contextWindow"],
  "additionalProperties": false,
  "properties": {
    "_compact": { "$ref": "https://zenmind.local/platform-auditor/schemas/common/common.schema.json#/definitions/compactMarker" },
    "chatId": { "type": "string" },
    "runId": { "type": "string" },
    "updatedAt": { "type": "number" },
    "liveSeq": {
      "$ref": "https://zenmind.local/platform-auditor/schemas/common/common.schema.json#/definitions/positiveInteger"
    },
    "messages": {
      "$ref": "https://zenmind.local/platform-auditor/schemas/common/common.schema.json#/definitions/messageArray"
    },
    "_type": { "type": "string", "enum": ["react"] },
    "modelKey": { "type": "string" },
    "responseId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$(?![\\s\\S])",
      "description": "该次已接受模型调用的上游响应 ID，可选且首尾不能包含空白"
    },
    "reasoningEffort": { "type": "string" },
    "seq": {
      "$ref": "https://zenmind.local/platform-auditor/schemas/common/common.schema.json#/definitions/positiveInteger"
    },
    "systemRef": { "type": "object", "additionalProperties": true },
    "system": { "type": "object", "additionalProperties": true },
    "contextWindow": {
      "$ref": "https://zenmind.local/platform-auditor/schemas/common/common.schema.json#/definitions/reactContextWindow"
    },
    "usage": {
      "$ref": "https://zenmind.local/platform-auditor/schemas/common/common.schema.json#/definitions/reactUsage"
    },
    "awaiting": {
      "$ref": "https://zenmind.local/platform-auditor/schemas/common/common.schema.json#/definitions/awaitingArray"
    },
    "stage": {
      "$ref": "https://zenmind.local/platform-auditor/schemas/common/common.schema.json#/definitions/planExecuteStage"
    },
    "plan": {},
    "debug": { "type": "object", "additionalProperties": true },
    "taskId": { "type": "string" },
    "taskStatus": {
      "$ref": "https://zenmind.local/platform-auditor/schemas/common/common.schema.json#/definitions/taskStatus"
    },
    "taskSubAgentKey": { "type": "string" },
    "taskAgentKey": { "type": "string" }
  }
}
