{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://zenmind.local/platform-auditor/schemas/jsonl/event.schema.json",
  "type": "object",
  "required": ["chatId", "runId", "updatedAt", "_type", "event"],
  "additionalProperties": false,
  "properties": {
    "_compact": { "$ref": "https://zenmind.local/platform-auditor/schemas/common/common.schema.json#/definitions/compactMarker" },
    "chatId": { "type": "string" },
    "runId": { "type": "string" },
    "updatedAt": { "type": "number" },
    "liveSeq": {
      "$ref": "https://zenmind.local/platform-auditor/schemas/common/common.schema.json#/definitions/positiveInteger"
    },
    "_type": { "type": "string", "enum": ["event"] },
    "event": {
      "allOf": [
        {
          "$ref": "https://zenmind.local/platform-auditor/schemas/common/common.schema.json#/definitions/eventPayload"
        },
        {
          "not": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": { "const": "request.steer" }
            }
          }
        }
      ]
    }
  }
}
