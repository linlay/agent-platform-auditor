{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://zenmind.local/platform-auditor/schemas/jsonl/steer.schema.json",
  "type": "object",
  "required": ["chatId", "runId", "updatedAt", "_type", "steer"],
  "additionalProperties": false,
  "properties": {
    "_compact": { "$ref": "https://zenmind.local/platform-auditor/schemas/common/common.schema.json#/definitions/compactMarker" },
    "chatId": { "type": "string", "minLength": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "updatedAt": { "type": "number" },
    "liveSeq": {
      "$ref": "https://zenmind.local/platform-auditor/schemas/common/common.schema.json#/definitions/positiveInteger"
    },
    "_type": { "type": "string", "enum": ["steer"] },
    "steer": {
      "$ref": "https://zenmind.local/platform-auditor/schemas/common/common.schema.json#/definitions/steerPayload"
    },
    "messages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "required": ["role", "content"],
        "properties": {
          "role": { "const": "user" },
          "content": { "type": ["string", "array"] }
        },
        "additionalProperties": true
      }
    }
  }
}
