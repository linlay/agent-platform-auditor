{
  "$schema": "https://zenmind.local/platform-auditor/schemas/rules/jsonl-rules.schema.json",
  "version": "2026-08-03.steer-hard-cut-v1",
  "recordRules": [
    {
      "id": "legacy-step",
      "op": "legacyStep",
      "severity": "info"
    },
    {
      "id": "usage-token-sum",
      "op": "sumEquals",
      "whenType": ["react", "plan-execute"],
      "left": ["usage.promptTokens", "usage.completionTokens"],
      "right": "usage.totalTokens",
      "severity": "warning",
      "code": "USAGE_TOKEN_SUM",
      "title": "usage token 合计不匹配",
      "path": "usage.totalTokens",
      "expected": "promptTokens + completionTokens"
    },
    {
      "id": "context-window-max",
      "op": "lessThanOrEqual",
      "whenType": ["react", "plan-execute"],
      "left": "contextWindow.currentSize",
      "right": "contextWindow.maxSize",
      "severity": "warning",
      "code": "CONTEXT_OVERFLOW",
      "title": "contextWindow 超限",
      "path": "contextWindow.currentSize"
    },
    {
      "id": "awaiting-nested-cursor",
      "op": "forbiddenAny",
      "whenType": ["react", "plan-execute"],
      "arrayPath": "awaiting",
      "fields": ["liveSeq", "seq"],
      "severity": "info",
      "code": "NESTED_LIVESEQ",
      "title": "awaiting 内含旧 cursor 字段",
      "expected": "top-level liveSeq"
    },
    {
      "id": "steer-chat-id-matches-envelope",
      "op": "equals",
      "whenType": ["steer"],
      "left": "steer.chatId",
      "right": "chatId",
      "severity": "error",
      "code": "STEER_CHATID_MISMATCH",
      "title": "steer.chatId 与顶层 chatId 不一致",
      "path": "steer.chatId",
      "expected": "top-level chatId"
    },
    {
      "id": "steer-run-id-matches-envelope",
      "op": "equals",
      "whenType": ["steer"],
      "left": "steer.runId",
      "right": "runId",
      "severity": "error",
      "code": "STEER_RUNID_MISMATCH",
      "title": "steer.runId 与顶层 runId 不一致",
      "path": "steer.runId",
      "expected": "top-level runId"
    }
  ],
  "crossRecordRules": [
    {
      "id": "jsonl-live-seq-by-run",
      "op": "liveSeqByRun",
      "severity": "warning",
      "typesExpectingLiveSeq": ["query", "react", "react-tool", "plan-execute", "submit", "event", "steer"],
      "skipMissingTypes": ["planning", "system", "step"],
      "allowEqualTypes": ["react-tool"]
    },
    {
      "id": "react-tool-seq-matches-previous-react",
      "op": "reactToolSeqMatchesPreviousReact",
      "severity": "error",
      "code": "REACT_TOOL_SEQ_MISMATCH",
      "title": "react-tool seq 未匹配上个 react",
      "path": "seq",
      "expected": "previous react seq"
    }
  ]
}
