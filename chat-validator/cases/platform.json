  {
    "id": "M01",
    "title": "四轮需求修订与结构化最终交付",
    "group": "multiturn",
    "action": "dialogue-revision",
    "steps": [
      "建立项目、预算和城市",
      "先后两次修订要求",
      "第四轮输出最终 JSON",
      "断言保留项目且不复活旧值"
    ]
  },
  {
    "id": "M02",
    "title": "主对话与旁路修改后的上下文隔离",
    "group": "multiturn",
    "action": "dialogue-branch",
    "steps": [
      "主对话创建草稿订单",
      "BTW 分支改为取消",
      "检查主 Run 未改变",
      "回到主对话核对原状态"
    ]
  },
  {
    "id": "S01",
    "title": "运行中 steer 修改需求并沿用原 Run",
    "group": "steer",
    "action": "steer-change",
    "steps": [
      "真实调用 wait 进入运行态",
      "发送新需求 steer",
      "等待因 steered 收口",
      "验证最终回答使用新值且 Run 未切换"
    ]
  },
  {
    "id": "S02",
    "title": "空白 steer 提前结束工具等待并继续",
    "group": "steer",
    "action": "steer-continue",
    "steps": [
      "进入真实工具等待",
      "发送空白 steer",
      "验证 continued 与 steered 工具结果",
      "检查同 Run 最终回答"
    ]
  },
  {
    "id": "S03",
    "title": "工具等待中 steer 注入新的 selection 引用",
    "group": "steer",
    "action": "steer-reference",
    "steps": [
      "进入工具等待",
      "steer 携带新选区引用",
      "模型消费新引用内容",
      "核对正文与 steerId"
    ]
  },
  {
    "id": "L01",
    "title": "Planning 确认后创建独立执行 Run",
    "group": "planning",
    "action": "plan-approve",
    "steps": [
      "生成计划并等待人工确认",
      "确认前不能启动执行 Run",
      "提交 approve",
      "attach 新执行 Run 并核对 planRunId"
    ]
  },
  {
    "id": "L02",
    "title": "Planning 拒绝反馈、修订、批准与执行",
    "group": "planning",
    "action": "plan-reject",
    "steps": [
      "生成第一版计划",
      "reject 并给出新要求",
      "同 Run 提交第二版计划",
      "批准后只执行修订版"
    ]
  },
  {
    "id": "L03",
    "title": "Planning 等待中 steer 使旧计划失效",
    "group": "planning",
    "action": "plan-steer",
    "steps": [
      "等待第一版计划确认",
      "steer 修改需求",
      "旧 approve 必须被拒绝",
      "新计划确认后执行并核对 superseded"
    ]
  },
  {
    "id": "I01",
    "title": "模型输出中 interrupt、空 query 续跑",
    "group": "interrupt",
    "action": "interrupt-output",
    "steps": [
      "观察到真实模型输出",
      "中断并验证 run.cancel",
      "详情 canContinue 必须为 true",
      "空 query 在同 Chat 开新 Run 并恢复上下文"
    ]
  },
  {
    "id": "I02",
    "title": "wait 工具运行中 interrupt 后续跑",
    "group": "interrupt",
    "action": "interrupt-wait",
    "steps": [
      "观察到 tool.wait",
      "中断工具与整个 Run",
      "等待取消终态和可续跑状态",
      "空 query 新 Run 恢复原任务"
    ]
  },
  {
    "id": "I03",
    "title": "提问工具暂停期间 interrupt 并拒绝旧提交",
    "group": "interrupt",
    "action": "interrupt-question",
    "steps": [
      "ask_user_question 进入暂停",
      "interrupt 取消等待项与 Run",
      "旧 submit 必须返回 409",
      "新消息在同 Chat 恢复任务"
    ]
  },
  {
    "id": "I04",
    "title": "提问工具暂停、提交回答、原 Run 继续",
    "group": "interrupt",
    "action": "question-resume",
    "steps": [
      "真实调用文本提问工具",
      "详情确认存在 awaiting",
      "提交测试答案",
      "同 Run 消费答案并完成"
    ]
  }
