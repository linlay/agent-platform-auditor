# Export variables in your shell. No .env file is automatically loaded.
PLATFORM_URL=http://127.0.0.1:11949
# Existing JWT file, read for each request; never copied into this project.
PLATFORM_TOKEN_FILE=
# Alternatively export PLATFORM_TOKEN without putting it in tracked files.
PLATFORM_AGENT_KEY=
PLATFORM_TIMEOUT_MS=120000
# Explicit opt-in targets; auto-discovery only selects a native GENERAL without Workspace.
PLATFORM_PROJECT_AGENT_KEY=
PLATFORM_PROJECT_FILE=
PLATFORM_PROJECT_EXPECT=
PLATFORM_BOT_AGENT_KEY=
